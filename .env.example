OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/google/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# GROBID setup guide: https://grobid.readthedocs.io/en/latest/Grobid-docker/
GROBID_URL=http://localhost:8070/
SUBNET_CLAIMS_RUN_LABEL=default
SUBNET_CLAIMS_JUDGE_TEMPERATURE=0.2
SUBNET_CLAIMS_JUDGE_MAX_TOKENS=32768

# Eligibility wire contract; batch validator retains one verbose paper per batch.
CLAIMS_ELIGIBILITY_OUTPUT_CONTRACT=compact
CLAIMS_ELIGIBILITY_SAMPLE_VERBOSE_PAPER=true

# OpenAI-compatible providers (e.g. cha86). Prefer env vars over hardcoding keys.
# SUBNET_CLAIMS_AGENT_PROVIDER=cha86
# SUBNET_CLAIMS_AGENT_MODEL=gpt-6-luna
# SUBNET_CLAIMS_AGENT_API_BASE=https://api.cha86.dev/v1
# SUBNET_CLAIMS_AGENT_API_KEY_ENV=CHA86_API_KEY
# CHA86_API_KEY=

# Consensus review (inherits extraction provider/model when unset; temperature is always 0).
# SUBNET_CLAIMS_CONSENSUS_MODE=model
# SUBNET_CLAIMS_CONSENSUS_PROVIDER=cha86
# SUBNET_CLAIMS_CONSENSUS_MODEL=gpt-6-luna
# SUBNET_CLAIMS_CONSENSUS_API_BASE=https://api.cha86.dev/v1
# SUBNET_CLAIMS_CONSENSUS_API_KEY_ENV=CHA86_API_KEY
# SUBNET_CLAIMS_CONSENSUS_BATCH_SIZE=1
# SUBNET_CLAIMS_CONSENSUS_MAX_TOKENS=8192

# Miner preflight: require quote/span/number grounding against source_payload before upload.
# SUBNET_CLAIMS_REQUIRE_SOURCE_GROUNDING=1
# SUBNET_CLAIMS_EXPERIMENT_VERSION=sn111d-preflight-v1
